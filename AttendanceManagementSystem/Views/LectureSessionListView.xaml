<UserControl x:Class="AttendanceManagementSystem.Views.LectureSessionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Margin="0,0,10,0" Padding="14,8" Command="{Binding CreateCommand}" Content="New Lecture Session" />
                <Button Padding="14,8" Command="{Binding BackCommand}" Content="Back to Dashboard" />
            </StackPanel>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="#1F2937" Text="Lecture Sessions" />
                <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="#667085" Text="{Binding CourseName, StringFormat=Course: {0}}" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Margin="0,0,0,10" Foreground="#B42318" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            <ListView Grid.Row="1" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession, Mode=TwoWay}" BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Padding="16" Background="White" CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1F2937" Text="{Binding LectureDate, StringFormat={}{0:dddd, MMMM d, yyyy}}" />
                                    <TextBlock Margin="0,4,0,0" Foreground="#667085" Text="{Binding Title, TargetNullValue=Untitled lecture}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#475467" Text="{Binding AttendanceRecords.Count, StringFormat={}{0} students}" />
                                <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="9,4" CornerRadius="10" Background="#EFF8FF">
                                    <TextBlock FontWeight="SemiBold" Foreground="#175CD3" Text="{Binding Status}" />
                                </Border>
                                <TextBlock Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#667085" Text="Open" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
