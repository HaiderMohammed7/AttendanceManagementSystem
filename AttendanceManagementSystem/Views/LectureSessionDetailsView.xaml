<UserControl x:Class="AttendanceManagementSystem.Views.LectureSessionDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AttendanceManagementSystem.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="PresentStatusTemplate"><Border Padding="8,4" Background="#ECFDF3" CornerRadius="8"><TextBlock FontWeight="SemiBold" Foreground="#027A48" Text="Present" /></Border></DataTemplate>
        <DataTemplate x:Key="AbsentStatusTemplate"><Border Padding="8,4" Background="#FEF3F2" CornerRadius="8"><TextBlock FontWeight="SemiBold" Foreground="#B42318" Text="Absent" /></Border></DataTemplate>
        <DataTemplate x:Key="NotMarkedStatusTemplate"><Border Padding="8,4" Background="#F2F4F7" CornerRadius="8"><TextBlock FontWeight="SemiBold" Foreground="#667085" Text="Not Marked" /></Border></DataTemplate>
        <views:AttendanceStatusTemplateSelector x:Key="AttendanceStatusSelector"
                                                PresentTemplate="{StaticResource PresentStatusTemplate}"
                                                AbsentTemplate="{StaticResource AbsentStatusTemplate}"
                                                NotMarkedTemplate="{StaticResource NotMarkedStatusTemplate}" />
    </UserControl.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Margin="0,0,10,0" Padding="14,8" Command="{Binding CompleteCommand}" Content="Complete Lecture" />
                <Button Padding="14,8" Command="{Binding BackCommand}" Content="Back to Sessions" />
            </StackPanel>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="#1F2937" Text="Session Details" />
                <TextBlock Margin="0,6,0,0" Foreground="#667085" Text="{Binding Title}" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Margin="0,0,0,16" Padding="16" Background="White" CornerRadius="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,0,28,0" FontWeight="SemiBold" Text="{Binding LectureDate, StringFormat={}{0:dddd, MMMM d, yyyy}}" />
                <TextBlock Margin="0,0,28,0" Foreground="#475467" Text="{Binding StatusText, StringFormat=Status: {0}}" />
                <TextBlock Foreground="#475467" Text="{Binding StudentCount, StringFormat={}{0} students}" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Margin="0,0,0,10" Foreground="#B42318" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            <ListView Grid.Row="1" ItemsSource="{Binding AttendanceRecords}" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="150" Header="University ID" DisplayMemberBinding="{Binding UniversityId}" />
                        <GridViewColumn Width="260" Header="Full Name" DisplayMemberBinding="{Binding FullName}" />
                        <GridViewColumn Width="130" Header="Status">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="StatusBadge" Padding="8,4" Background="#F2F4F7" CornerRadius="8">
                                        <TextBlock x:Name="StatusText" FontWeight="SemiBold" Foreground="#667085" Text="{Binding StatusText}" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsPresent}" Value="True">
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#ECFDF3" />
                                            <Setter TargetName="StatusText" Property="Foreground" Value="#027A48" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAbsent}" Value="True">
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#FEF3F2" />
                                            <Setter TargetName="StatusText" Property="Foreground" Value="#B42318" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="90" Header="Present">
                            <GridViewColumn.CellTemplate><DataTemplate><Button Padding="8,4" Command="{Binding PresentCommand}" Content="Present" /></DataTemplate></GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="90" Header="Absent">
                            <GridViewColumn.CellTemplate><DataTemplate><Button Padding="8,4" Command="{Binding AbsentCommand}" Content="Absent" /></DataTemplate></GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
