<UserControl x:Class="AttendanceManagementSystem.Views.StudentManagementView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="720">
    <UserControl.Resources>
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#172033"/>
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#D8E2EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#D8E2EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DBEAFE"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FEF2F2"/>
                    <Setter Property="BorderBrush" Value="#FCA5A5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Background" Value="#ECFDF3"/>
        </Style>

        <DataTemplate x:Key="StatusTemplate">
            <Border x:Name="StatusBadge" Style="{StaticResource StatusBadgeStyle}">
                <TextBlock x:Name="StatusText" FontSize="11" FontWeight="SemiBold" Foreground="#027A48" Text="Active"/>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter TargetName="StatusBadge" Property="Background" Value="#F1F5F9"/>
                    <Setter TargetName="StatusText" Property="Foreground" Value="#64748B"/>
                    <Setter TargetName="StatusText" Property="Text" Value="Inactive"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="StudentListItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="8,9"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StudentColumnHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="DetailsContentStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedStudent}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EmptyStateStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedStudent}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchPlaceholderStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding CourseName}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Margin="0,0,8,0" Command="{Binding ImportCommand}" Content="Import CSV" Style="{StaticResource PrimaryButton}"/>
                <Button Command="{Binding ExportStudentReportCommand}" Content="Export Report" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Grid Width="440">
                    <TextBox x:Name="SearchBox" MinHeight="40" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="12,8"/>
                    <TextBlock Text="Search by ID or student name..." Margin="13,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#94A3B8" IsHitTestVisible="False" Style="{StaticResource SearchPlaceholderStyle}"/>
                </Grid>

                <Button Margin="9,0,0,0" Command="{Binding RefreshCommand}" Content="↻  Refresh" Style="{StaticResource PrimaryButton}" Padding="16,10"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" MinWidth="340"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource DashboardCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Student List" Style="{StaticResource SectionHeading}" Margin="0,0,0,12"/>

                    <ListView Grid.Row="1" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent, Mode=TwoWay}" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource StudentListItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource StudentColumnHeaderStyle}">
                                <GridViewColumn Width="110" Header="University ID" DisplayMemberBinding="{Binding UniversityId}"/>
                                <GridViewColumn Width="240" Header="Full Name" DisplayMemberBinding="{Binding FullName}"/>
                                <GridViewColumn Width="85" Header="Status" CellTemplate="{StaticResource StatusTemplate}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                <Grid>
                    <Border Style="{StaticResource EmptyStateStyle}" Background="Transparent">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="52" Height="52" Background="#F1F5F9" CornerRadius="12" HorizontalAlignment="Center">
                                <TextBlock Text="?" FontSize="25" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="No Student Selected" Margin="0,14,0,0" FontSize="15" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center"/>
                            <TextBlock Text="Select a student to view details" Margin="0,6,0,0" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Grid Style="{StaticResource DetailsContentStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Student Details" Style="{StaticResource SectionHeading}" Margin="0,0,0,12"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="University ID" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedUniversityId}" Margin="0,5,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Status" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedStatusText}" Margin="0,5,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                                    </StackPanel>
                                </Grid>

                                <Rectangle Height="1" Fill="#EDF1F6" Margin="0,13,0,12"/>
                                <TextBlock Text="Full Name" Style="{StaticResource InfoLabel}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding EditedFullName, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{Binding SelectedStudentError}" Margin="0,4,0,0" FontSize="11" Foreground="#DC2626" TextWrapping="Wrap"/>
                                <Rectangle Height="1" Fill="#EDF1F6" Margin="0,13,0,12"/>
                                <TextBlock Text="Attendance Statistics" Style="{StaticResource SectionHeading}" FontSize="14"/>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Background="#F0FDF4" CornerRadius="8" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Present" FontSize="11" Foreground="#15803D"/>
                                            <TextBlock Text="{Binding PresentCount}" Margin="0,3,0,0" FontSize="23" FontWeight="Bold" Foreground="#16A34A"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Margin="8,0,0,0" Background="#FEF2F2" CornerRadius="8" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Absent" FontSize="11" Foreground="#B91C1C"/>
                                            <TextBlock Text="{Binding AbsentCount}" Margin="0,3,0,0" FontSize="23" FontWeight="Bold" Foreground="#DC2626"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,11,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Attendance" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding AttendancePercentage, StringFormat={}{0}}" Margin="0,3,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Absence" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding AbsencePercentage, StringFormat={}{0}}" Margin="0,3,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                                    </StackPanel>
                                </Grid>

                                <Border Margin="0,11,0,0" Padding="10" Background="#FFFAF0" BorderBrush="#FDECC8" BorderThickness="1" CornerRadius="7">
                                    <StackPanel>
                                        <TextBlock Text="Warning Status" FontSize="11" Foreground="#92400E"/>
                                        <TextBlock Text="{Binding WarningStatus}" Margin="0,3,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#B45309" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Rectangle Height="1" Fill="#EDF1F6" Margin="0,13,0,12"/>

                                <TextBlock Text="Attendance History" Style="{StaticResource SectionHeading}" FontSize="14"/>

                                <ListView Height="180" Margin="0,9,0,4" ItemsSource="{Binding AttendanceHistory}" BorderBrush="#E2E8F0" BorderThickness="1" Background="White" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.View>
                                        <GridView ColumnHeaderContainerStyle="{StaticResource StudentColumnHeaderStyle}">
                                            <GridViewColumn Width="75" Header="Date" DisplayMemberBinding="{Binding LectureDate, StringFormat={}{0:MM/dd/yyyy}}"/>
                                            <GridViewColumn Width="105" Header="Title" DisplayMemberBinding="{Binding Title}"/>
                                            <GridViewColumn Width="65" Header="Session" DisplayMemberBinding="{Binding SessionStatus}"/>
                                            <GridViewColumn Width="85" Header="Attendance" DisplayMemberBinding="{Binding AttendanceStatusText}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <Button Command="{Binding SaveNameCommand}" Content="Save Name" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Padding="12,9" Margin="0,0,0,7"/>
                            <Button Command="{Binding DeactivateCommand}" Content="Deactivate Student" Style="{StaticResource DangerButton}" HorizontalAlignment="Stretch" Padding="12,9"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>