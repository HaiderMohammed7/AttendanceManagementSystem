<UserControl x:Class="AttendanceManagementSystem.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="28" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="14" Foreground="#667085" Text="A concise overview of your attendance workspace." />
                    <TextBlock Margin="0,5,0,0" FontSize="18" FontWeight="SemiBold" Foreground="#182230" Text="{Binding CourseName}" />
                </StackPanel>
                <Button Grid.Column="1" Padding="12,7" Command="{Binding RefreshStatisticsCommand}" Content="Refresh" />
            </Grid>
            <Border Margin="0,18,0,0" Padding="20" Background="White" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#182230" Text="Course overview" />
                    <UniformGrid Margin="0,16,0,0" Columns="4">
                        <StackPanel><TextBlock Foreground="#667085" Text="Instructor" /><TextBlock Margin="0,4,12,0" FontWeight="SemiBold" Text="{Binding InstructorName}" TextTrimming="CharacterEllipsis" /></StackPanel>
                        <StackPanel><TextBlock Foreground="#667085" Text="Academic Year" /><TextBlock Margin="0,4,12,0" FontWeight="SemiBold" Text="{Binding AcademicYear}" /></StackPanel>
                        <StackPanel><TextBlock Foreground="#667085" Text="Semester" /><TextBlock Margin="0,4,12,0" FontWeight="SemiBold" Text="{Binding Semester}" /></StackPanel>
                        <StackPanel><TextBlock Foreground="#667085" Text="Active Students" /><TextBlock Margin="0,4,0,0" FontSize="22" FontWeight="SemiBold" Foreground="#2F6DB5" Text="{Binding ActiveStudents}" /></StackPanel>
                    </UniformGrid>
                    <UniformGrid Margin="0,18,0,0" Columns="2">
                        <StackPanel><TextBlock Foreground="#667085" Text="Completed Lectures" /><TextBlock Margin="0,4,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding CompletedLectures}" /></StackPanel>
                        <StackPanel><TextBlock Foreground="#667085" Text="Draft Lectures" /><TextBlock Margin="0,4,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding DraftLectures}" /></StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
            <Border Margin="0,16,0,0" Padding="20" Background="White" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#182230" Text="Attendance overview" />
                    <UniformGrid Margin="0,14,0,0" Columns="3">
                        <StackPanel><TextBlock Foreground="#667085" Text="Present" /><TextBlock Margin="0,3,0,0" FontSize="22" FontWeight="SemiBold" Foreground="#16794A" Text="{Binding TotalPresent}" /></StackPanel>
                        <StackPanel><TextBlock Foreground="#667085" Text="Absent" /><TextBlock Margin="0,3,0,0" FontSize="22" FontWeight="SemiBold" Foreground="#B42318" Text="{Binding TotalAbsent}" /></StackPanel>
                        <StackPanel><TextBlock Foreground="#667085" Text="Students with Warnings" /><TextBlock Margin="0,3,0,0" FontSize="22" FontWeight="SemiBold" Foreground="#B54708" Text="{Binding StudentsWithWarnings}" /></StackPanel>
                    </UniformGrid>
                    <Grid Width="260" Height="12" Margin="0,18,0,0" HorizontalAlignment="Left">
                        <Border Background="#F4B4B0" CornerRadius="6" />
                        <Border Width="{Binding PresentBarWidth}" HorizontalAlignment="Left" Background="#47B881" CornerRadius="6" />
                    </Grid>
                    <TextBlock Margin="0,7,0,0" Foreground="#667085" Text="{Binding AttendanceSummary}" />
                </StackPanel>
            </Border>
            <Border Margin="0,16,0,0" Padding="20" Background="White" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <Grid>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#182230" Text="Students requiring attention" />
                        <Button HorizontalAlignment="Right" Padding="10,6" Command="{Binding ViewAllWarningsCommand}" Content="View All" />
                    </Grid>
                    <TextBlock Margin="0,8,0,0" Foreground="#B42318" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,7" Padding="10" Background="#FFF8EB" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding FullName}" /><TextBlock FontSize="12" Foreground="#667085" Text="{Binding UniversityId}" /></StackPanel>
                                        <TextBlock Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center" Foreground="#B54708" Text="{Binding AbsenceCount, StringFormat={}{0} absences}" />
                                        <Button Grid.Column="2" Padding="9,5" Command="{Binding OpenCommand}" Content="Open" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>