<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="AttendanceManagementSystem.Views.DashboardView">
    <UserControl.Resources>
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#172033"/>
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#D8E2EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DBEAFE"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"  Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WarningRow" TargetType="Border">
            <Setter Property="Background" Value="#FFFAF0"/>
            <Setter Property="BorderBrush" Value="#FEEDC8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#F4F7FB">
        <StackPanel MaxWidth="1500" HorizontalAlignment="Stretch">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CourseName}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding RefreshStatisticsCommand}" Content="↻  Refresh" Style="{StaticResource PrimaryButton}" Padding="17,11" VerticalAlignment="Center"/>
            </Grid>

            <Border Style="{StaticResource DashboardCard}">
                <StackPanel>
                    <TextBlock Text="Course overview"  Style="{StaticResource SectionHeading}"/>
                    <UniformGrid Columns="4" Margin="0,18,0,0">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Instructor" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="{Binding InstructorName}" Margin="0,5,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#334155" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Academic Year" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="{Binding AcademicYear}" Margin="0,5,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Semester" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="{Binding Semester}" Margin="0,5,0,0" FontSize="13"  FontWeight="SemiBold" Foreground="#334155"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Active Students" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="{Binding ActiveStudents}" Margin="0,3,0,0" FontSize="25" FontWeight="Bold" Foreground="#2563EB"/>
                        </StackPanel>
                    </UniformGrid>

                    <Rectangle Height="1" Fill="#EDF1F6" Margin="0,18,0,16"/>

                    <UniformGrid Columns="2">
                        <StackPanel>
                            <TextBlock Text="Completed Lectures" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="{Binding CompletedLectures}" Margin="0,4,0,0" FontSize="23" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Draft Lectures" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="{Binding DraftLectures}" Margin="0,4,0,0" FontSize="23" FontWeight="Bold" Foreground="#64748B"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DashboardCard}">
                <StackPanel>
                    <TextBlock Text="Attendance overview" Style="{StaticResource SectionHeading}"/>
                    <Grid Margin="0,17,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Present" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="{Binding TotalPresent}" Margin="0,4,0,0" FontSize="25" FontWeight="Bold" Foreground="#16A34A"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Absent" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Text="{Binding TotalAbsent}" Margin="0,4,0,0" FontSize="25" FontWeight="Bold" Foreground="#DC2626"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,17,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding PresentPercentage, StringFormat={}{0:F1}% Present}" Foreground="#159A59" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding AbsentPercentage, StringFormat={}{0:F1}% Absent}" Foreground="#DC5252" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>

                    </Grid>

                    <ProgressBar Height="11" Minimum="0" Maximum="100" Value="{Binding PresentPercentage, Mode=OneWay}" Background="#FEE2E2" Foreground="#22A06B" BorderThickness="0" HorizontalAlignment="Stretch"  ClipToBounds="True">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Grid ClipToBounds="True">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5"/>

                                    <Border x:Name="PART_Track">
                                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="5"/>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>

                    <Border Margin="0,18,0,0" Padding="14" Background="#FFFAF0" BorderBrush="#FDECC8" BorderThickness="1" CornerRadius="9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="38" Height="38" Background="#FEF0CF" CornerRadius="8" VerticalAlignment="Center">
                                <TextBlock Text="!" FontSize="20" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="13,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="Students with Warnings" FontSize="13" FontWeight="SemiBold" Foreground="#92400E"/>
                                <TextBlock Text="Students who reached the absence warning threshold" Margin="0,3,0,0" FontSize="11" Foreground="#A16207"/>
                            </StackPanel>

                            <TextBlock  Grid.Column="2" Text="{Binding StudentsWithWarnings}"  FontSize="24" FontWeight="Bold" Foreground="#D97706" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DashboardCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Students requiring attention" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/>

                        <Button Grid.Column="1" Command="{Binding ViewAllWarningsCommand}" Background="Transparent"
                            Foreground="#2563EB" BorderThickness="0" Padding="8,5" FontSize="12" FontWeight="SemiBold" Cursor="Hand">

                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content" Value="View All  ↓"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowAllWarnings}" Value="True">
                                            <Setter Property="Content" Value="Show Less  ↑"/>
                                        </DataTrigger>

                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#1D4ED8"/>
                                        </Trigger>
                                        
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <TextBlock Margin="0,7,0,0" Foreground="#DC2626" FontSize="12" Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>

                    <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding VisibleWarnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource WarningRow}">
                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FullName}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>

                                            <TextBlock Text="{Binding UniversityId}" Margin="0,3,0,0"  FontSize="11"  Foreground="#64748B"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding AbsenceCount, StringFormat={}{0} absences}" Margin="12,0,18,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#B45309"/>

                                        <Button Grid.Column="2" Content="Open  →" Command="{Binding OpenCommand}" Style="{StaticResource PrimaryButton}" Padding="13,7" FontSize="11"/>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>