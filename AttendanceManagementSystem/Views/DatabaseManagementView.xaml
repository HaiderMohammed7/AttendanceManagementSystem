<UserControl x:Class="AttendanceManagementSystem.Views.DatabaseManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="28" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock FontSize="14" Foreground="#667085" Text="Create a native SQL Server backup or restore a verified backup through the staged recovery workflow." TextWrapping="Wrap" />
            <Border Margin="0,18,0,0" Padding="20" Background="White" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#182230" Text="Backup and restore" />
                    <TextBlock Margin="0,5,0,14" Foreground="#667085" Text="A restore creates a safety backup and requires an application restart." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <Button Margin="0,0,10,0" Padding="14,8" Command="{Binding CreateBackupCommand}" Content="Create Backup" />
                        <Button Padding="14,8" Command="{Binding RestoreDatabaseCommand}" Content="Restore Database" />
                    </StackPanel>
                    <TextBlock Margin="0,16,0,0" Foreground="#16794A" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" Foreground="#B42318" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,10,0,0" Foreground="#667085" Text="{Binding IsBusy, StringFormat=Operation in progress: {0}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>