<UserControl x:Class="AttendanceManagementSystem.Views.LectureSessionCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Padding="14,8" Command="{Binding CancelCommand}" Content="Back to Sessions" />
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="#1F2937" Text="New Lecture Session" />
                <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="#667085" Text="{Binding CourseName, StringFormat=Course: {0}}" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" MaxWidth="620" Padding="24" HorizontalAlignment="Left" VerticalAlignment="Top" Background="White" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontWeight="SemiBold" Foreground="#344054" Text="Lecture date" />
                <DatePicker Grid.Row="1" Margin="0,8,0,4" SelectedDate="{Binding LectureDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Foreground="#B42318" Text="{Binding LectureDateError}" />
                <TextBlock Grid.Row="3" Margin="0,18,0,0" FontWeight="SemiBold" Foreground="#344054" Text="Title (optional)" />
                <TextBox Grid.Row="4" Margin="0,8,0,18" Padding="9,7" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Row="5">
                    <TextBlock Margin="0,0,0,12" Foreground="#B42318" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                    <Button Width="170" Padding="14,8" HorizontalAlignment="Left" Command="{Binding SaveCommand}" Content="Create Draft Session" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
