<Window x:Class="AttendanceManagementSystem.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AttendanceManagementSystem.Views"
        xmlns:viewModels="clr-namespace:AttendanceManagementSystem.ViewModels"
        Title="Attendance Manager"
        Width="1200"
        Height="800"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#C9D3E5" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="10,3" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#263B5E" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#315B9A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowSidebarLabels}" Value="False">
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="11,11" />
                    <Setter Property="Margin" Value="6,3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashboardSidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDashboardSelected}" Value="True">
                    <Setter Property="Background" Value="#2F6DB5" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StudentsSidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStudentsSelected}" Value="True">
                    <Setter Property="Background" Value="#2F6DB5" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LecturesSidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLectureSessionsSelected}" Value="True">
                    <Setter Property="Background" Value="#2F6DB5" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReportsSidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReportsSelected}" Value="True">
                    <Setter Property="Background" Value="#2F6DB5" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DatabaseSidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDatabaseManagementSelected}" Value="True">
                    <Setter Property="Background" Value="#2F6DB5" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CourseSettingsSidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCourseSettingsSelected}" Value="True">
                    <Setter Property="Background" Value="#2F6DB5" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type viewModels:CourseSetupViewModel}">
            <views:CourseSetupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:StudentManagementViewModel}">
            <views:StudentManagementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LectureSessionListViewModel}">
            <views:LectureSessionListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LectureSessionCreateViewModel}">
            <views:LectureSessionCreateView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LectureSessionDetailsViewModel}">
            <views:LectureSessionDetailsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:DatabaseManagementViewModel}">
            <views:DatabaseManagementView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#F3F6FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#142642"
                Visibility="{Binding IsShellVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>


                <Border Grid.Row="0"
                        Padding="16,22,16,20"
                        Background="#142642">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="40"
                                Background="#2F6DB5"
                                CornerRadius="9"
                                Visibility="{Binding ShowSidebarLabels, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="A"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="11,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowSidebarLabels, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Attendance"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="White" />
                            <TextBlock Text="Manager"
                                       FontSize="12"
                                       Foreground="#9FB0C9" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Margin="0"
                                HorizontalAlignment="Center"
                                Command="{Binding ToggleSidebarCommand}"
                                Style="{StaticResource SidebarButtonStyle}"
                                ToolTip="{Binding SidebarToggleLabel}">
                            <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="#C9D3E5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>
                        <TextBlock Text="MAIN MENU"
                                   Margin="24,0,0,8"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#8FA4C3"
                                   Visibility="{Binding ShowSidebarLabels, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Button Command="{Binding ShowDashboardCommand}"
                                Style="{StaticResource DashboardSidebarButtonStyle}"
                                ToolTip="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Width="28" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Text="Dashboard"
                                           Visibility="{Binding ShowSidebarLabels, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ShowStudentsCommand}"
                                Style="{StaticResource StudentsSidebarButtonStyle}"
                                ToolTip="Students">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="18" Width="28" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Text="Students"
                                           Visibility="{Binding ShowSidebarLabels, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ShowLectureSessionsCommand}"
                                Style="{StaticResource LecturesSidebarButtonStyle}"
                                ToolTip="Lecture Sessions">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="18" 
                                           Width="28" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Text="Lecture Sessions"
                                           Visibility="{Binding ShowSidebarLabels, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ShowReportsCommand}"
                                Style="{StaticResource ReportsSidebarButtonStyle}"
                                ToolTip="Reports">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="18" Width="28" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Text="Reports"
                                           Visibility="{Binding ShowSidebarLabels, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="SYSTEM"
                                   Margin="24,28,0,8"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#8FA4C3"
                                   Visibility="{Binding ShowSidebarLabels, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Button Command="{Binding ShowDatabaseManagementCommand}"
                                Style="{StaticResource DatabaseSidebarButtonStyle}"
                                ToolTip="Database Management">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18" 
                                           Width="28" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Text="Database Management"
                                           Visibility="{Binding ShowSidebarLabels, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding EditCourseCommand}"
                                Style="{StaticResource CourseSettingsSidebarButtonStyle}"
                                ToolTip="Course Settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="28" 
                                           TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Text="Course Settings"
                                           Visibility="{Binding ShowSidebarLabels, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Margin="16,12,16,20"
                        Padding="12"
                        Background="#1D3353"
                        CornerRadius="8">

                    <Grid>
                        <StackPanel Visibility="{Binding ShowSidebarLabels, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="CURRENT COURSE"
                                       FontSize="11"
                                       Foreground="#8FA4C3" />
                            <TextBlock Text="{Binding CourseName}"
                                       Margin="0,5,0,0"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="#8FA4C3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   ToolTip="{Binding CourseName}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowSidebarLabels}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Visibility="{Binding IsShellVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="#E1E7EF" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#182230" Text="{Binding CurrentPageTitle}" />
                        <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="#667085" Text="Attendance Manager workspace" />
                    </StackPanel>
                    <TextBlock Margin="0,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#667085" Text="{Binding CourseName}" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
            <Border Grid.Row="1" Margin="24" Background="White" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="10">
                <ContentControl Content="{Binding CurrentViewModel}" />
            </Border>
        </Grid>

        <ContentControl Grid.ColumnSpan="2" Content="{Binding CurrentViewModel}" Visibility="{Binding IsCourseSetupVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</Window>