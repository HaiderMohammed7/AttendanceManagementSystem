<Window x:Class="AttendanceManagementSystem.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AttendanceManagementSystem.Views"
        xmlns:viewModels="clr-namespace:AttendanceManagementSystem.ViewModels"
        Title="Attendance Management System"
        Width="900"
        Height="560"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:CourseSetupViewModel}">
            <views:CourseSetupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#F5F7FA">
        <ContentControl Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
