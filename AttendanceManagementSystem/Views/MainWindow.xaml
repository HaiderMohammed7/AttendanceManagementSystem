<Window x:Class="AttendanceManagementSystem.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attendance Management System"
        Width="900"
        Height="560"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F5F7FA">
        <Border Margin="32"
                Padding="40"
                Background="White"
                CornerRadius="12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"
                           Text="{Binding WelcomeMessage}" />
                <TextBlock Margin="0,12,0,0"
                           FontSize="16"
                           Foreground="#667085"
                           Text="Your attendance workspace is ready for the next phase."
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
