<UserControl x:Class="AttendanceManagementSystem.Views.CourseSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="520">
    <UserControl.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="FieldErrorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#B42318" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="720" Margin="32" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,28">
                <TextBlock FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="#1F2937"
                           Text="{Binding FormTitle}" />
                <TextBlock Margin="0,8,0,0"
                           FontSize="15"
                           Foreground="#667085"
                           Text="{Binding FormDescription}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,16">
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Course Name" />
                <TextBox Text="{Binding CourseName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource FieldErrorStyle}" Text="{Binding CourseNameError}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,16">
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Instructor Name" />
                <TextBox Text="{Binding InstructorName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource FieldErrorStyle}" Text="{Binding InstructorNameError}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,16">
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Academic Year" />
                <TextBox Text="{Binding AcademicYear, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource FieldErrorStyle}" Text="{Binding AcademicYearError}" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,0,0,16">
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Semester" />
                <ComboBox ItemsSource="{Binding SemesterOptions}"
                          SelectedItem="{Binding Semester, UpdateSourceTrigger=PropertyChanged}"
                          IsTextSearchEnabled="False" />
                <TextBlock Style="{StaticResource FieldErrorStyle}" Text="{Binding SemesterError}" />
            </StackPanel>

            <TextBlock Grid.Row="3"
                       Grid.ColumnSpan="2"
                       Margin="0,4,0,16"
                       Foreground="#B42318"
                       Text="{Binding SaveError}"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Row="4"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button MinWidth="100"
                        Margin="0,0,10,0"
                        Padding="16,9"
                        Command="{Binding CancelCommand}"
                        Content="Cancel"
                        Visibility="{Binding CancelVisibility}" />
                <Button MinWidth="100"
                        Padding="16,9"
                        Command="{Binding SaveCommand}"
                        Content="Save" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
